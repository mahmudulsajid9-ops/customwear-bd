# CustomWear BD — Environment Variables Example
# Copy this file to .env.local for local development

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication & Session Secret (Used for HMAC SHA-256 session tokens)
AUTH_SECRET=customwear-bd-production-super-secret-key-change-me

# Business Information
NEXT_PUBLIC_BRAND_NAME="CustomWear BD"
NEXT_PUBLIC_BRAND_TAGLINE="Your Design, Your Style"
NEXT_PUBLIC_LOCATION="AK Khan, Chattogram, Bangladesh"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"

# Optional: Cloud PostgreSQL / Supabase Credentials
# (If omitted, CustomWear BD automatically uses the fast, zero-dependency built-in SQLite database at data/customwear.db)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-private-key
